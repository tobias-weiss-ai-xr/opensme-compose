// SOGo Groupware — production config template for up to 500 users
// Connects to Stalwart via IMAP/SMTP, PostgreSQL via PgBouncer.
//
// mail/sogo/sogo-entrypoint.sh renders this file at container start with a
// plain sed substitution per variable, so only bare ${VAR} placeholders are
// replaced — ${VAR:-default} is NOT expanded here.
//
// Debugging note: SOGo never dispatches a UI action before the XSRF check.
// Every action URL (e.g. /SOGo/so/<user>/Mail/mailAccounts) needs the
// X-XSRF-TOKEN header carrying the XSRF-TOKEN cookie set at login; without it
// SOPE answers HTTP 500 with the 36-byte body "the called object returned no
// result" (invalidLogin page + assets keep working). See docs/E2E-JOURNEYS.md
// → webmail, and tests/05-e2e/webmail.py which probes it the browser's way.

{
  // Server
  WOPort = 20000;
  WOHTTPEnabled = YES;
  WOLogFile = /var/log/sogo/sogo.log;
  SOPidFile = /var/run/sogo/sogo.pid;
  WOWorkersCount = 8;

  // Database — PostgreSQL as sogo_user (owner of the sogo database, created
  // by postgres-init/01-create-users.sh). SOGO_DB_PASSWORD is generated
  // separately from POSTGRES_PASSWORD, so connecting as the superuser fails.
  // Each URL is db/table; SOGo does not default the profile URL, and without
  // it login is impossible even though the page renders.
  SOGoProfileURL = "postgresql://sogo_user:${SOGO_DB_PASSWORD}@postgres:5432/sogo/sogo_user_profile";
  OCSFolderInfoURL = "postgresql://sogo_user:${SOGO_DB_PASSWORD}@postgres:5432/sogo/sogo_folder_info";
  OCSSessionsFolderURL = "postgresql://sogo_user:${SOGO_DB_PASSWORD}@postgres:5432/sogo/sogo_sessions_folder";
  OCSStoreURL = "postgresql://sogo_user:${SOGO_DB_PASSWORD}@postgres:5432/sogo/sogo_store";
  OCSACLsURL = "postgresql://sogo_user:${SOGO_DB_PASSWORD}@postgres:5432/sogo/sogo_acl";

  // Session cache: the stack memcached (SOGo prefixes its keys). The image
  // default 127.0.0.1 is not running, which disables the cache after retries.
  SOGoMemcachedHost = "memcached";

  // Authentication: mail users from PostgreSQL (table mail_users), with the
  // password check delegated to Zitadel via OpenID Connect (webmail SSO,
  // docs/ROADMAP.md Epic C3).
  //
  // No directory service, on purpose: this stack serves <= 500 users, and an
  // LDAP daemon would be a fourth moving part for one table. Stalwart (Rust)
  // owns IMAP/SMTP; Postgres holds the same users as SOGo's LOOKUP source —
  // under OpenID auth the SQL source only maps the IdP identity onto a mail
  // account (canAuthenticate stays YES for that; SOGo never checks
  // c_password itself, the IdP owns the password).
  //
  // Identity contract (must stay aligned across Zitadel, mail_users and
  // Stalwart): the IdP's email claim is <user>@${OPENSME_DOMAIN}; the
  // provisioner writes exactly that value into mail_users.c_uid, and
  // Stalwart's OIDC directory names principals after the same claim. SOGo
  // logs in to Stalwart with IMAPLoginFieldName (= c_uid) over XOAUTH2, so
  // all three names are the same string.
  //
  // The viewURL needs the same percent-encoded password as the OCS URLs
  // above — a raw '/' in a base64 password invalidates it exactly the same way.
  SOGoUserSources = (
    {
      type = sql;
      id = "opensme-mail-users";
      viewURL = "postgresql://sogo_user:${SOGO_DB_PASSWORD}@postgres:5432/sogo/mail_users";
      canAuthenticate = YES;
      isAddressBook = YES;
      displayName = "openSME Mail";
      // Column contract of mail_users (see postgres-init/02-mail-users.sql):
      // c_uid, c_name, c_password, c_cn, mail — fixed names, SQL sources map
      // them directly (the LDAP keys CNFieldName/UIDFieldName do not apply).
      MailFieldNames = (mail);
      IMAPLoginFieldName = c_uid;
      // Passwords are stored as {scheme}hash (Dovecot scheme names); the
      // scheme prefix wins over this default, so the column can hold
      // {SHA512-CRYPT}$6$… today and a different scheme later without
      // touching sogo.conf.
      userPasswordAlgorithm = sha512-crypt;
      prependPasswordScheme = YES;
    }
  );

  // OpenID Connect (webmail SSO): SOGo 5.12's native OIDC support. The
  // browser is redirected to Zitadel's authorize endpoint and comes back to
  // /SOGo/?code=..., where sogod exchanges the code server-side. The client
  // pair is minted by scripts/zitadel-client.sh --app sogo (redirect URIs
  // registered there must match this deployment's SOGO_DOMAIN).
  //
  // OCSOpenIdURL is SOGo's OIDC session store (table sogo_openid; SOGo
  // creates the table itself, so the schema floor assertions in tests
  // tolerate extra tables). SOGoXSRFValidationEnabled = NO is REQUIRED for
  // the openid flow — the IdP redirect chain cannot carry the XSRF token
  // the SQL-login form posts. Session-level XSRF for UI actions stays on.
  SOGoAuthenticationType = openid;
  SOGoXSRFValidationEnabled = NO;
  OCSOpenIdURL = "postgresql://sogo_user:${SOGO_DB_PASSWORD}@postgres:5432/sogo/sogo_openid";
  SOGoOpenIdConfigUrl = "https://${ZITADEL_DOMAIN}/.well-known/openid-configuration";
  SOGoOpenIdClient = "${SOGO_OIDC_CLIENT_ID}";
  SOGoOpenIdClientSecret = "${SOGO_OIDC_CLIENT_SECRET}";
  SOGoOpenIdScope = "openid profile email offline_access";
  // The userinfo claim whose value must equal the SQL source's c_uid (see
  // the identity contract above). Zitadel's email claim is exactly
  // <user>@${OPENSME_DOMAIN}.
  SOGoOpenIdEmailParam = "email";
  SOGoOpenIdEnableRefreshToken = YES;
  SOGoOpenIdTokenCheckInterval = 300;
  SOGoOpenIdLogoutEnabled = YES;

  // Mail (via Stalwart)
  SOGoDraftsFolderName = Drafts;
  SOGoSentFolderName = "Sent Items";
  SOGoTrashFolderName = "Deleted Items";
  SOGoJunkFolderName = "Junk Mail";
  SOGoMailDomain = "${OPENSME_DOMAIN}";
  // Plain IMAP on 143, inside the compose network only. Stalwart's self-signed
  // rcgen certificate carries SAN=DNS:localhost, and SOGo's IMAP client
  // verifies the peer hostname, so the implicit-TLS listener (993) answers
  // SOGoIMAPServer="stalwart" with "hostname mismatch".
  // mail/stalwart/config.toml.template therefore enables
  // [imap.auth] allow-plain-text and mail/stalwart.yml publishes neither 993
  // nor any other TLS port for IMAP.
  SOGoIMAPServer = "stalwart";
  SOGoSMTPServer = "stalwart";
  // With the password owned by the IdP, SOGo never has a plaintext secret
  // for the mail hop — it presents the OIDC access token as an XOAUTH2
  // SASL credential, which Stalwart validates against Zitadel's userinfo
  // endpoint (see mail/stalwart/config.toml.template [directory.oidc]).
  SOGoSMTPAuthenticationType = xoauth2;
  NGImap4AuthMechanism = xoauth2;
  SOGoForceExternalLoginWithEmail = NO;
  SOGoMailSpoolPath = "/tmp";

  // Performance
  SOGoMaximumSyncWindowSize = 100;
  SOGoConnectionsPoolSize = 20;
  SOGoPendingDropBoxEnabled = YES;
  SOGoPendingDropBoxSizeLimit = 50;
  SOGoPendingMailDropBoxSizeLimit = 50;

  // General
  SOGoTimeZone = "${TZ}";
  SOGoLanguage = German;
  SOGoAppointmentSendEMailNotifications = YES;

  // Calendar & Contacts
  SOGoEnablePublicAccess = NO;
  SOGoFreeBusyDefaultInterval = 600;
  SOGoFreeBusyPublishInterval = 60;
}
