# Stalwart Mail Server (v0.15.x) — full v0.15 config schema, rendered by
# mail/stalwart/stalwart-entrypoint.sh from env:
#   MAIL_DOMAIN              -> mail hostname (informational)
#   STALWART_ADMIN_PASSWORD  -> initial admin password (fallback-admin)
#   STALWART_PUBLIC_URL      -> public WebUI/JMAP URL (optional)
#   STALWART_BIND            -> listener bind address: [::] on a dual-stack
#                               host, 0.0.0.0 when the container has no IPv6.
#                               Resolved by the entrypoint, overridable.
# Listeners are plain (Traefik terminates TLS for web; mail is internal).
# Store lives on the stalwart-data volume (RocksDB).

[server]
hostname = "${MAIL_DOMAIN}"
# NOTE: plain ${MAIL_DOMAIN} — the entrypoint renderer does not understand
# the bash "${VAR:-default}" form and would bake the literal string in,
# which also breaks stalwart's own EHLO-domain validation (550 Invalid
# EHLO domain for internal relays like zitadel's notifier).

[server.listener.smtp]
bind = "${STALWART_BIND}:25"
protocol = "smtp"

[server.listener.submission]
bind = "${STALWART_BIND}:587"
protocol = "smtp"

[server.listener.imap]
bind = "${STALWART_BIND}:143"
protocol = "imap"

[server.listener.http]
protocol = "http"
bind = "${STALWART_BIND}:8080"

[storage]
data = "rocksdb"
fts = "rocksdb"
blob = "rocksdb"
lookup = "rocksdb"
# Mail users authenticate against the IdP: the default directory validates
# OIDC access tokens (IMAP/SMTP XOAUTH2/OAUTHBEARER from SOGo) against
# Zitadel's userinfo endpoint and auto-provisions the principal on first
# login. Plain password logins now verify APP passwords only (upstream
# contract of an oidc-type directory) — regular clients mint app passwords,
# webmail users just sign in via SSO. The pre-provisioned principals
# (scripts/provision-demo-users.sh) still carry their seeded secrets; they
# are inert while this directory is oidc.
directory = "oidc"

[store.rocksdb]
type = "rocksdb"
path = "/var/lib/stalwart/data"
compression = "lz4"

# Webmail SSO: validate the IdP's access tokens (SASL XOAUTH2/OAUTHBEARER).
# Zitadel's userinfo endpoint is reached on the compose network over plain
# HTTP — the endpoint URL is used as-is (no discovery, no issuer check in
# v0.15), and the edge's self-signed dev certificate would fail reqwest's
# default TLS verification. The principal name comes from the email claim
# (fields.username unset → falls back to fields.email), which is the same
# <user>@<OPENSME_DOMAIN> string SOGo maps through mail_users.c_uid.
[directory.oidc]
type = "oidc"
store = "rocksdb"
endpoint.method = "userinfo"
# The userinfo URL MUST carry the external IdP host — Zitadel rejects requests
# whose Host header differs from its configured ExternalDomain (404), so the
# container name does not work. It must ALSO be plain HTTP: the edge terminates
# TLS with a per-boot self-signed certificate that cannot be pinned, and the
# release build of Stalwart verifies TLS unconditionally (no config knob).
# The fix is traefik's internal-only `idpplain` entrypoint (:8081, never
# published): same external hostname → right Host header, no TLS hop.
# Traefik's network alias for ${ZITADEL_DOMAIN} makes the name resolvable here.
endpoint.url = "http://${ZITADEL_DOMAIN}:8081/oidc/v1/userinfo"
fields.email = "email"
timeout = "30s"

[tracer.log]
type = "log"
level = "info"
path = "/var/lib/stalwart/logs"
prefix = "stalwart.log"
rotate = "daily"
ansi = false
enable = true

[authentication.fallback-admin]
user = "admin"
secret = "${STALWART_ADMIN_PASSWORD}"

# zitadel's go net/smtp notifier always sends "EHLO localhost"; without
# this the internal relay path (auth -> mail) fails with 550 Invalid EHLO
[session.ehlo]
reject-non-fqdn = false

# SOGo's IMAP client (SOPE) connects without STARTTLS (url=...?tls=NO) and
# refuses Stalwart's self-signed certificate, so the hop stays in clear text on
# the compose network. Without this, LOGIN is answered with
# "NO LOGIN is disabled on the clear-text port." and the webmail stays empty.
[imap.auth]
allow-plain-text = true

# Settings that are not matched by `local-keys` below live in Stalwart's own
# store, where the stored value silently wins over the value written in this
# file (the server logs "Database key defined in local configuration" for
# every such key). The overlay keeps its auth/session/IMAP switches here on
# purpose, so they must be listed as local keys.
[config]
local-keys = [
  "store.*",
  "directory.*",
  "tracer.*",
  "!server.blocked-ip.*",
  "!server.allowed-ip.*",
  "server.*",
  "authentication.fallback-admin.*",
  "cluster.*",
  "config.local-keys.*",
  "storage.data",
  "storage.blob",
  "storage.lookup",
  "storage.fts",
  "storage.directory",
  "certificate.*",
  "session.*",
  "imap.*",
  "smtp.*",
]
