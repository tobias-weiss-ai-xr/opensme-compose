# ──────────────────────────────────────────────
# openSME Compose — Configuration
# ──────────────────────────────────────────────
# Copy to .env and adjust for your deployment.
# See README.md for hardware recommendations per tier.

# ── Domains ──
OPENSME_DOMAIN=opensme.graphwiz.ai
OPENCLOUD_DOMAIN=cloud.opensme.graphwiz.ai
MAIL_DOMAIN=mail.opensme.graphwiz.ai
SOGO_DOMAIN=webmail.opensme.graphwiz.ai
COLLABORA_DOMAIN=collabora.opensme.graphwiz.ai
ZITADEL_DOMAIN=auth.opensme.graphwiz.ai
# Zitadel image (v3 line — current images need an external init+setup)
ZITADEL_IMAGE=ghcr.io/zitadel/zitadel:v4.19.4
PORTAL_DOMAIN=home.opensme.graphwiz.ai

# ── Database ──
POSTGRES_PASSWORD=CHANGEME_postgres
REDIS_PASSWORD=CHANGEME_redis
# ZITADEL_DB_NAME=zitadel (auto-created by postgres-init)
SOGO_DB_PASSWORD=CHANGEME_sogo

# ── LDAP ──
# DN derived from OPENSME_DOMAIN, e.g. opensme.graphwiz.ai → dc=opensme,dc=graphwiz,dc=ai
# Override only if your domain maps to a different DN structure.
LDAP_ROOT_DN=dc=opensme,dc=graphwiz,dc=ai
LDAP_ADMIN_PASSWORD=CHANGEME_ldap
LDAP_USER_PASSWORD=CHANGEME_user

# ── Zitadel (IAM/SSO) ──
# Zitadel first admin (created on first start)
ZITADEL_ADMIN_EMAIL=admin@opensme.graphwiz.ai
ZITADEL_ADMIN_PASSWORD=CHANGEME_zitadel

# ── OpenCloud ──
OC_ADMIN_USERNAME=admin
OC_ADMIN_PASSWORD=CHANGEME_oc_admin
OC_OIDC_CLIENT_SECRET=CHANGEME_oidc_client
# ^ Zitadel mints the real client id + secret when scripts/zitadel-client.sh
#   registers the OpenCloud OIDC client on first demo boot; that registered
#   pair is written back into .env (OC_OIDC_CLIENT_ID / OC_OIDC_CLIENT_SECRET).
# OC_JWT_SECRET, OC_TRANSFER_SECRET, OC_URL_SIGNING_SECRET:
# Auto-generated by opencloud init on first run (stored in opencloud-config volume).
# No manual configuration needed.
OC_S3_ENDPOINT=http://minio:9000
OC_S3_REGION=us-east-1
OC_S3_BUCKET=opencloud
OC_S3_ACCESS_KEY=minio
OC_S3_SECRET_KEY=CHANGEME_minio
OC_INSECURE=true
# ^ true is correct for Docker Compose — inter-service traffic stays on the
#   internal network (no TLS). Security boundary is Traefik.
NOTIFICATIONS_SMTP_SENDER=noreply@opensme.graphwiz.ai
# ^ Sender address for OpenCloud notification emails

# ── Collabora ──
COLLABORA_USERNAME=admin
COLLABORA_PASSWORD=CHANGEME_collabora

# ── Mail backend switch ──────────────────────
# Which mail stack to run. Strict XOR — never both:
#   stalwart (default) — Stalwart SMTP/IMAP + SOGo groupware overlays
#   mailcow            — full mailcow stack via scripts/mailcow.sh (submodule);
#                        Stalwart/SOGo must NOT be mounted in this mode.
MAIL_BACKEND=stalwart

# ── Mail (Stalwart) ──
STALWART_ADMIN_PASSWORD=CHANGEME_stalwart_admin
# ^ Stalwart admin password (required for initial setup)

# ── Mail (mailcow, optional full mail server — submodule) ──
# The mailcow-dockerized stack is vendored as a git submodule at
# mail/mailcow-dockerized (pinned to an upstream release). Enable with:
#   git submodule update --init mail/mailcow-dockerized
#   scripts/mailcow.sh up [hostname]
# These values seed the rendered mail/mailcow.conf (gitignored). Boot via
# MAIL_BACKEND=mailcow + `scripts/mailcow.sh up` (or make mailcow-up):
MAILCOW_DBPASS=CHANGEME_mailcow_db
MAILCOW_REDISPASS=CHANGEME_mailcow_redis
MAILCOW_API_KEY=
# ^ generate when empty: scripts/mailcow.sh fills a random key
MAILCOW_HOSTNAME=
# ^ default: mail.${OPENSME_DOMAIN:-opensme.graphwiz.ai}
MAILCOW_SKIP_CLAMD=y
MAILCOW_SKIP_FTS=y
# host-side loopback ports for mailcow's own web stack (Traefik reaches
# nginx via the container network; pick any free loopback port):
#MAILCOW_HTTP_PORT=28080
#MAILCOW_HTTPS_PORT=28443
# ^ keep the demo lean; set n for production-grade antivirus/full-text search

# ── Traefik ──
TRAEFIK_ACME_EMAIL=admin@opensme.graphwiz.ai
# ACME directory. Default (unset) = LE STAGING — demo-safe, since the
# demo's .local/.test hosts can't get real certs. For production set:
# TRAEFIK_ACME_CA_SERVER=https://acme-v02.api.letsencrypt.org/directory
# Generate with: htpasswd -nb admin your-password
TRAEFIK_USERS=admin:$apr1$CHANGEME

# ── Portal ──
# Empty = card hidden from portal landing page. Catalog functions only:
# identity/auth and Collabora (embedded editor) never get tiles.
MAIL_URL=
# Optional component cards (empty = hidden):
#   BPM_URL       https://bpm.<OPENSME_DOMAIN>       (camunda profile)
#   INVOICE_URL   https://invoice.<OPENSME_DOMAIN>   (invoice profile)
#   PAPERLESS_URL https://docs.<OPENSME_DOMAIN>      (paperless profile)
#   CHAT_URL      https://chat.<OPENSME_DOMAIN>      (synapse profile)
#   NOTES_URL     https://notes.<OPENSME_DOMAIN>     (notes service)

# ── Logging ──
LOG_LEVEL=info
LOG_PRETTY=true
TZ=Europe/Berlin

# ── Coexist Profile (existing Traefik) ──
# Set when using profiles/demo.coexist.yml to piggyback on a host Traefik.
EXISTING_NETWORK=traefik-web
EXISTING_TRAEFIK_HTTPS=websecure

# ── Feature Flags (set COMPOSE_FILE in env or cli) ──
COMPOSE_FILE=docker-compose.yml

# ── Optional Services (per-service DB passwords) ──
# Only needed if the corresponding service profile is enabled.
CASDOOR_DB_PASSWORD=CHANGEME_casdoor
SYNAPSE_DB_PASSWORD=CHANGEME_synapse
# Zitadel-minted OIDC credentials (scripts/zitadel-client.sh --app synapse);
# a real (non-CHANGEME) client id is the opt-in switch for the OIDC block
SYNAPSE_OIDC_CLIENT_ID=
SYNAPSE_OIDC_CLIENT_SECRET=CHANGEME_synapse_oidc
PAPERLESS_DB_PASSWORD=CHANGEME_paperless
PAPERLESS_SECRET_KEY=CHANGEME_generate_64_chars
INVOICENINJA_DB_PASSWORD=CHANGEME_invoiceninja
NOTES_DB_PASSWORD=CHANGEME_notes
NOTES_DJANGO_SECRET_KEY=CHANGEME_notes_django
# Zitadel-minted OIDC credentials (scripts/zitadel-client.sh --app notes)
NOTES_OIDC_CLIENT_ID=
NOTES_OIDC_CLIENT_SECRET=CHANGEME_notes_oidc
NOTES_COLLABORATION_SECRET=CHANGEME_notes_collab

# ── Nosdesk ticketing (--profile ticketing) ──
NOSDESK_DB_PASSWORD=CHANGEME_nosdesk_db
# openssl rand -base64 32
NOSDESK_JWT_SECRET=CHANGEME_nosdesk_jwt
# openssl rand -hex 32
NOSDESK_MFA_KEK=CHANGEME_nosdesk_mfa
NOSDESK_OIDC_ISSUER=
NOSDESK_OIDC_CLIENT_ID=
NOSDESK_OIDC_CLIENT_SECRET=

# ── Operaton (BPMN workflow, --profile camunda) ──
# Operaton is the community-owned Apache 2.0 successor of Camunda 7 CE
# (same engine lineage, API/model/DB-schema compatible). The upstream
# image ships H2/MySQL/PostgreSQL JDBC drivers — no custom build needed.
# Override the image tag here (pinned to 2.1.5 by default).
# Service name and profile retain the "camunda" label for backward compat.
CAMUNDA_IMAGE=
CAMUNDA_DB_PASSWORD=CHANGEME_camunda
# Operaton host (defaults to bpm.<OPENSME_DOMAIN>); set to bpm.home.<domain>
# when using the coexist profile behind a fleet Traefik.
CAMUNDA_DOMAIN=

# ── Portal extras ──
# JSON array of {"level":"info|warn","text":"…"} banners shown on the portal
# Example: [{"level":"info","text":"Welcome to openSME"},{"level":"warn","text":"Maintenance window: Sun 02:00–04:00"}]
PORTAL_ANNOUNCEMENTS=
# HTTP CONNECT proxy for the portal's outbound feed fetches (HTTPS_PROXY inside
# the portal container). Only needed on egress-restricted hosts where container
# traffic cannot leave directly (e.g. OpenVZ without working MASQUERADE):
# point it at a local proxy reachable from the docker bridges, e.g.
# PORTAL_HTTPS_PROXY=http://<docker-gateway-ip>:8888 — empty = direct egress (default).
PORTAL_HTTPS_PROXY=
# News columns on the portal ("Aktuelles"), server-side RSS/Atom aggregation:
# JSON array of {"id","title","urls":[…]}. Empty = default columns:
#   startup (t3n, deutsche-startups), Markt (manager-magazin, handelsblatt),
#   Legal (LTO). Example: [{"id":"it","title":"IT","urls":["https://example.org/feed"]}]
PORTAL_FEEDS=
# BPM/Workflow (Operaton) — set to https://bpm.<OPENSME_DOMAIN> to show the
# Workflow card on the portal (requires --profile camunda)
BPM_URL=
# OpenAI-compatible chat endpoint, e.g. http://vllm:8000 (empty hides the AI card)
# With `--profile ai` set it to http://ai:8080 (built-in llama.cpp server)
AI_API_URL=
AI_MODEL=CHANGEME_model_name
AI_API_KEY=
# Intercom: hosts allowed as attachment sources (comma-separated,
# "host" or "host:port"; default cloud.<OPENSME_DOMAIN>) and a dev
# escape hatch to allow http:// attachment URLs (never set in prod)
INTERCOM_ATTACHMENT_HOSTS=
INTERCOM_ALLOW_HTTP=
# Team notes persistence: JSON file for the intercom store (picked-file
# uploads live in attachments/ next to it). Empty = compose default
# /data/intercom.json on the portal-data volume; survives restarts.
INTERCOM_DATA_PATH=
# Polls (Umfragen): optional portal card + API. POLLS_ENABLED=1 turns the
# feature on. Attachments go to the cloud (OpenCloud) when CLOUD_WEBDAV_*
# are set — portal PUTs via WebDAV and creates a public read-only share
# link (OCS API); without them uploads fall back to the local
# attachments/ dir next to POLLS_DATA_PATH. CLOUD_SHARE_URL overrides the
# OCS shares endpoint (default: derived from CLOUD_WEBDAV_URL host).
POLLS_ENABLED=
POLLS_DATA_PATH=
# Machine auth on OpenCloud (see opencloud/opencloud.yml): required when
# the cloud sits behind an external IdP (Zitadel) and the portal uploads
# poll attachments + creates their public shares via WebDAV/OCS.
OPENCLOUD_ENABLE_BASIC_AUTH=
CLOUD_WEBDAV_URL=
CLOUD_WEBDAV_USER=
CLOUD_WEBDAV_PASS=
CLOUD_SHARE_URL=
# Comma-separated hosts the cloud-upload client must reach WITHOUT the
# egress proxy (docker-net service names, e.g. opensme-opencloud)
PORTAL_NO_PROXY=
# Portal cards for optional components (empty = card hidden)
TICKETING_URL=
CMS_URL=
SHOP_URL=
# Surveys (LimeSurvey CE) — https://surveys.${OPENSME_DOMAIN}
SURVEYS_URL=
# LimeSurvey tuning (upgrades: bump LIMESURVEY_TAG, data survives in
# limesurvey_db + limesurvey-uploads volume)
LIMESURVEY_TAG=6-apache
# public host for the survey tool (routed by traefik); the portal tile
# URL (SURVEYS_URL) is usually https://$SURVEYS_DOMAIN
SURVEYS_DOMAIN=surveys.${OPENSME_DOMAIN:-opensme.graphwiz.ai}
SURVEYS_DB_PASSWORD=
# Initial LimeSurvey admin (effective on FIRST start only)
SURVEYS_ADMIN_USER=admin
SURVEYS_ADMIN_PASSWORD=

# ── crap-cms website (--profile cms) ──
# upstream publishes :latest only; pin here once semver tags exist, e.g.
# CMS_IMAGE=ghcr.io/dkluhzeb/crap-cms:0.1.0
CMS_IMAGE=

# ── RaisFast store (--profile store) ──
# bootstrap admin password (otherwise printed once to logs on first boot)
STORE_ADMIN_PASSWORD=CHANGEME_store_admin
# build arch for the local image: x86_64 (amd64) or aarch64 (arm64)
STORE_ARCH=x86_64

# ── llama.cpp AI server (--profile ai) ──
# OpenAI-compatible inference at http://ai:8080 (point AI_API_URL there)
# build-numbered tag — llama.cpp publishes no semver docker tags
AI_IMAGE=
# HuggingFace model repo:quant, auto-downloaded to the ai-models volume on
# first boot (~1 GB for the default). Pick bigger models for more capability.
AI_HF_MODEL=
CRYPTPAD_ADMIN_EMAIL=admin@opensme.graphwiz.ai
CPAD_SESSION_SECRET=CHANGEME_cpad

# ── Monitoring (optional overlays) ──
# Include via COMPOSE_FILE=docker-compose.yml:monitoring/dev-agent.yml
# Images (replace with your registry/tag when ready):
#   Build locally with Nix: cd monitoring/nix && nix build .#dev-agent .#predictive-agent .#taskfleet
#   Then: docker load < result-dev-agent  (etc.)
#   Nix-built images use the *-nix tag (e.g., dev-agent:latest-nix)
DEV_AGENT_IMAGE=ghcr.io/tobias-weiss-ai-xr/dev-agent:latest
PREDICTIVE_AGENT_IMAGE=ghcr.io/tobias-weiss-ai-xr/predictive-agent:latest
TASKFLEET_IMAGE=ghcr.io/tobias-weiss-ai-xr/taskfleet:latest
# dev-maintenance-bot (Go, one-shot, runbook KB + consent-gated healing):
# DEV_MAINTENANCE_BOT_IMAGE=opensme-dev-maintenance-bot:latest   # local build via `make agent-build`
# DEV_AGENT_INTERVAL=60s          # reconcile interval
# DEV_AGENT_WATCH=opensme-compose   # comma-separated compose projects to watch
# DEV_AGENT_ALLOW_HEAL=false      # MUST stay false unless you accept real restarts
# DEV_AGENT_HOSTNAMES=            # extra hostnames the anonymizer scrubs (comma-separated)
# DEV_AGENT_HISTORY_MAX=100       # cap on persisted history+evidence entries
# DEV_AGENT_LLM_BACKEND=none      # none|ollama|saia|tud|openai — none = never dial out
# DEV_AGENT_LLM_URL=              # override backend URL
# DEV_AGENT_LLM_MODEL=            # override backend model
# DEV_AGENT_LLM_KEY=              # override backend API key (never logged)
# DEV_MAINTENANCE_BOT_LLM_BACKEND=none  # bot-specific LLM opt-in (independent of DEV_AGENT_LLM_BACKEND)
# LLM backend (ollama | saia | tud | openai)
# For local Ollama, include monitoring/ollama.yml and keep OLLAMA_URL=http://ollama:11434
# For external LLM, set OLLAMA_URL to the endpoint and provide API keys as needed.
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen3-30b-a3b:latest
OLLAMA_TIMEOUT=180
# External LLM API keys (optional — only needed if LLM_BACKEND != ollama)
# DEV_AGENT_LLM_BACKEND=ollama
# PREDICTIVE_AGENT_LLM_BACKEND=ollama
# SAIA_API_URL=https://chat-ai.academiccloud.de/v1
# SAIA_API_KEY=
# TUD_API_URL=https://llm-service.ai.tu-darmstadt.de/v1
# TUD_API_KEY=
# OPENAI_API_URL=https://api.openai.com/v1
# OPENAI_API_KEY=
# Watch namespaces (comma-separated Docker compose project names)
# DEV_AGENT_WATCH_NAMESPACES=opensme,default
# PREDICTIVE_AGENT_WATCH_NAMESPACES=opensme,default
# Reconcile / analysis tuning
# DEV_AGENT_RECONCILE_INTERVAL=60
# PREDICTIVE_AGENT_RECONCILE_INTERVAL=60
# PREDICTION_ENABLED=true
# PREDICTION_RISK_THRESHOLD=0.5
# taskfleet
# TF_REPO_DIR=/path/to/your/repo
# TF_MAX_PARALLEL=2

# ── Image digest pinning ────────────────────────────────
# Pin stable images to a specific digest for reproducible deploys.
# Each <IMG>_IMAGE override in the compose files honours the digest form:
#   TRAEFIK_IMAGE_DIGEST=traefik:v3.3@sha256:<hex>
#   POSTGRES_IMAGE_DIGEST=postgres:17-alpine@sha256:<hex>
#   REDIS_IMAGE_DIGEST=redis:7-alpine@sha256:<hex>
#   MEMCACHED_IMAGE_DIGEST=memcached:1.6-alpine@sha256:<hex>
#   STALWART_IMAGE_DIGEST=stalwartlabs/stalwart:v0.15@sha256:<hex>
#   SOGO_IMAGE_DIGEST=salvoxia/sogo:latest@sha256:<hex>
# When set, keep the corresponding service's <IMG>_IMAGE pointing at the
# same tag@digest (asserted by tests/00-static/check_perf.py).

# ── Optional container image overrides ────────────
STALWART_IMAGE=stalwartlabs/stalwart:v0.15
COLLABORA_IMAGE=collabora/code:latest
PGBOUNCER_IMAGE=bitnamilegacy/pgbouncer:latest
TIKA_IMAGE=apache/tika:latest
