# ──────────────────────────────────────────────
# openSME Compose — Configuration
# ──────────────────────────────────────────────
# Copy to .env and adjust for your deployment.
# See README.md for hardware recommendations per tier.

# ── Domains ──
OPENSME_DOMAIN=opensme.graphwiz.ai
# OpenCloud (ocis) public hostname — served by Traefik; also drives
# OC_DOMAIN/OC_URL in opencloud.yml and the Collabora aliasgroup.
# Grouped/documented under "OpenCloud Core" below.
OPENCLOUD_DOMAIN=cloud.opensme.graphwiz.ai
MAIL_DOMAIN=mail.opensme.graphwiz.ai
SOGO_DOMAIN=webmail.opensme.graphwiz.ai
COLLABORA_DOMAIN=collabora.opensme.graphwiz.ai
ZITADEL_DOMAIN=auth.opensme.graphwiz.ai
# Zitadel image (v3 line — current images need an external init+setup)
ZITADEL_IMAGE=ghcr.io/zitadel/zitadel:v4.19.4
PORTAL_DOMAIN=home.opensme.graphwiz.ai

# ── Database ──
POSTGRES_PASSWORD=CHANGEME_postgres
REDIS_PASSWORD=CHANGEME_redis
# ZITADEL_DB_NAME=zitadel (auto-created by postgres-init)
SOGO_DB_PASSWORD=CHANGEME_sogo
# Zitadel-minted OIDC credentials for the webmail SSO (Epic C3; minted by
# scripts/zitadel-client.sh --app sogo). Until both keys hold a real pair,
# SOGo renders an empty OIDC client id and the SSO redirect fails loudly at
# the IdP — the webmail journey enforces this contract.
SOGO_OIDC_CLIENT_ID=
SOGO_OIDC_CLIENT_SECRET=
# The tenant domain sogo6 embeds in its OIDC callback
# (/api/user/v1/auth/callback/{TENANT}). Derived from SOGO_DOMAIN (leading
# 'webmail.' stripped — webmail.home.opensme.graphwiz.ai ->
# home.opensme.graphwiz.ai); override when the login tenant differs.
# SOGO_OIDC_DOMAIN=
# The *.local callback variant for demo-stack logins (derived from the
# first label of SOGO_OIDC_DOMAIN; override for a custom tenant suffix).
# SOGO_OIDC_LOCAL_DOMAIN=

# OIDC discovery URL for SOGo. Defaults to the Traefik-fronted https URL.
# Override to http://auth.opensme.local:8080/.well-known/openid-configuration
# when running without Traefik (e.g. sogo6-nginx occupies :80/:443) so SOGo
# reaches Zitadel directly via the Docker network alias (see idm/zitadel.yml).
# Zitadel OIDC discovery URL for SOGo — EMPTY default so the compose
# overlay derives it from ZITADEL_DOMAIN (matching the demo path); a
# hardcoded graphwiz URL here breaks greenfield .local deployments.
ZITADEL_OIDC_URL=
# SOGo proxy bypass: corporate HTTP proxy must not intercept internal Docker
# traffic. Covers Docker networks + .opensme.local domain.
# SOGo proxy bypass. When running behind a corporate HTTP proxy, extend
# this with the RFC1918 ranges of your Docker bridge networks (the working
# value lives in your gitignored .env).
SOGO_NO_PROXY=localhost,127.0.0.1,.opensme.local

# ── Zitadel (IAM/SSO) ──
# Zitadel first admin (created on first start)
ZITADEL_ADMIN_EMAIL=admin@opensme.graphwiz.ai
ZITADEL_ADMIN_PASSWORD=CHANGEME_zitadel
# Zitadel Login v2 UI: signs the login session cookie (>= 32 chars).
# demo.sh generates a random one; when unset the login app falls back to
# deriving the key from the login-client PAT (deprecated upstream).
LOGIN_SESSION_COOKIE_SECRET=CHANGEME_session_cookie_secret_at_least_32_chars
# Portal OIDC RP (backend sign-in for intercom/polls): client registered by
# scripts/zitadel-client.sh --app portal which replaces the placeholder with
# the Zitadel-minted id/secret in .env (compose requires these via ${VAR:?}).
PORTAL_OIDC_CLIENT_ID=CHANGEME_portal_oidc
PORTAL_OIDC_CLIENT_SECRET=CHANGEME_portal_oidc

# ── OpenCloud ──
# OpenCloud (ocis) is the file-sync/share platform, fronted by Traefik at
# https://${OPENCLOUD_DOMAIN} and federated with Zitadel for SSO. Internal
# service address: opensme-opencloud:9200. Variables are grouped into Core,
# WebDAV Access, and S3 Access below. See docs/opencloud.md for the full
# reference (description, default, required, example, used-by) and
# integration/troubleshooting patterns.

# ── OpenCloud Core ──
# OPENCLOUD_DOMAIN — public hostname served by Traefik (defined in the
#   Domains section above). Drives OC_DOMAIN/OC_URL in opencloud.yml and
#   the Collabora aliasgroup. Example: cloud.opensme.graphwiz.ai
# OpenCloud bootstrap admin (created on first start; rotate in prod).
OC_ADMIN_USERNAME=admin
OC_ADMIN_PASSWORD=CHANGEME_oc_admin
# Zitadel-minted OIDC client for browser SSO. scripts/zitadel-client.sh
# --app opencloud registers a PUBLIC PKCE app on first demo boot and writes
# the real id/secret back into .env (OC_OIDC_CLIENT_ID / OC_OIDC_CLIENT_SECRET).
OC_OIDC_CLIENT_SECRET=CHANGEME_oidc_client
# ^ placeholder until the registered pair is written back; see above.
# A non-empty OC_OIDC_CLIENT_ID is the opt-in switch: with nothing set,
# compose falls back to the 'opencloud' label, which is NOT a registered
# client — the web login dead-ends at Errors.App.NotFound.
OC_OIDC_CLIENT_ID=
# OC_JWT_SECRET, OC_TRANSFER_SECRET, OC_URL_SIGNING_SECRET:
# Auto-generated by opencloud init on first run (stored in opencloud-config volume).
# No manual configuration needed.
# Accept self-signed/internal TLS on inter-service calls. true is correct
# for Docker Compose — inter-service traffic stays on the internal network
# (no TLS). Security boundary is Traefik.
OC_INSECURE=true
# Machine auth on OpenCloud (see opencloud/opencloud.yml): set to true when
# the portal/LimeSurvey upload poll attachments via WebDAV/OCS using a
# Basic-auth service account. Off by default; enable together with
# CLOUD_WEBDAV_*. NOTE: Basic-auth/DAV accounts cannot carry OpenCloud's
# default `name` (displayName) claim, so opencloud.yml sets
# PROXY_AUTOPROVISION_CLAIM_DISPLAYNAME=preferred_username — without it
# every Basic request 500s ("missing claim 'name'"). Side effect:
# OpenCloud's own UI shows login names as display names (cosmetic).
OPENCLOUD_ENABLE_BASIC_AUTH=
# Sender address for OpenCloud notification emails (password-reset / share
# notifications, relayed via Stalwart). The full SMTP relay is configured by
# OC_SMTP_* in your .env (host/port/user/pass); only the sender is required
# in .env.example.
NOTIFICATIONS_SMTP_SENDER=noreply@opensme.graphwiz.ai

# ── OpenCloud WebDAV Access ──
# Used by the portal cloud bridge (portal/src/cloud.rs) and the LimeSurvey
# cloud-sync sidecar to upload files and create public share links over
# WebDAV/OCS against OpenCloud. Requires OPENCLOUD_ENABLE_BASIC_AUTH=true
# (Basic-auth service account). All four empty = cloud uploads disabled
# (portal falls back to local attachments/; LimeSurvey sync idles).
# Base WebDAV URL (internal service address). Point at the OpenCloud DAV
# endpoint for the service account, e.g.
#   http://opensme-opencloud:9200/remote.php/dav/files/<user>
CLOUD_WEBDAV_URL=
# Basic-auth username for the WebDAV service account (created in OpenCloud's
# IDM). Often the same as OC_ADMIN_USERNAME for a single-account setup.
CLOUD_WEBDAV_USER=
# Basic-auth password for the WebDAV service account. Keep secret; rotate
# via the OpenCloud IDM. Empty disables portal cloud uploads + share
# creation.
CLOUD_WEBDAV_PASS=
# Optional override for the OCS shares API endpoint used to create public
# read-only share links. Default: derived from CLOUD_WEBDAV_URL host, e.g.
#   http://opensme-opencloud:9200/ocs/v2.php/apps/files_sharing/api/v1/shares
# Set only when the shares endpoint differs from the WebDAV host (e.g. an
# edge-routed public URL).
CLOUD_SHARE_URL=

# ── OpenCloud S3 Access ──
# S3-compatible object storage (SeaweedFS, network-aliased as `minio` on
# opensme-net, S3 API on :9000). OC_S3_* is the single source of truth;
# service overlays (notes, invoice-ninja) map them to their own AWS_*/AWS_S3_*
# env vars. The access/secret pair MUST match opencloud/seaweedfs-s3.json.
# S3 endpoint (internal). SeaweedFS serves the S3 API on :9000 and is
# aliased as `minio` for backward compatibility with MinIO-era configs.
OC_S3_ENDPOINT=http://minio:9000
# S3 region (cosmetic for SeaweedFS; some SDKs require a non-empty value).
OC_S3_REGION=us-east-1
# Default S3 bucket name. Per-service buckets are derived by the overlays
# (e.g. notes-media, invoiceninja); this is the shared default.
OC_S3_BUCKET=opencloud
# S3 access key — must match the accessKey in opencloud/seaweedfs-s3.json.
OC_S3_ACCESS_KEY=minio
# S3 secret key — must match the secretKey in opencloud/seaweedfs-s3.json.
# CHANGEME placeholder: override on real deployments and keep in sync with
# seaweedfs-s3.json.
OC_S3_SECRET_KEY=CHANGEME_minio

# ── OpenCloud CalDAV/CardDAV ──
# CalDAV endpoint for calendar access. Used by portal calendar integration
# and SOGo CalDAV proxy. Defaults to the OpenCloud CalDAV API path.
OPENCLOUD_CALDAV_URL=https://cloud.${OPENCLOUD_DOMAIN}/remote.php/dav/calendars
# CardDAV endpoint for contacts/contacts access.
OPENCLOUD_CARDDAV_URL=https://cloud.${OPENCLOUD_DOMAIN}/remote.php/dav/addressbooks
# WebDAV principals endpoint (required for CalDAV/CardDAV discovery).
OPENCLOUD_PRINCIPAL_URL=https://cloud.${OPENCLOUD_DOMAIN}/remote.php/dav/principals

# ── Collabora ──
COLLABORA_USERNAME=admin
COLLABORA_PASSWORD=CHANGEME_collabora

# ── Mail backend switch ──────────────────────
# Which mail stack to run. Strict XOR — never both:
#   stalwart (default) — Stalwart SMTP/IMAP + SOGo groupware overlays
#   mailcow            — full mailcow stack via scripts/mailcow.sh (submodule);
#                        Stalwart/SOGo must NOT be mounted in this mode.
MAIL_BACKEND=stalwart

# ── Mail (Stalwart) ──
STALWART_ADMIN_PASSWORD=CHANGEME_stalwart_admin
# ^ Stalwart admin password (required for initial setup)

# ── Mail (mailcow, optional full mail server — submodule) ──
# The mailcow-dockerized stack is vendored as a git submodule at
# mail/mailcow-dockerized (pinned to an upstream release). Enable with:
#   git submodule update --init mail/mailcow-dockerized
#   scripts/mailcow.sh up [hostname]
# These values seed the rendered mail/mailcow.conf (gitignored). Boot via
# MAIL_BACKEND=mailcow + `scripts/mailcow.sh up` (or make mailcow-up):
MAILCOW_DBPASS=CHANGEME_mailcow_db
MAILCOW_REDISPASS=CHANGEME_mailcow_redis
MAILCOW_API_KEY=
# ^ generate when empty: scripts/mailcow.sh fills a random key
MAILCOW_HOSTNAME=
# ^ default: mail.${OPENSME_DOMAIN:-opensme.graphwiz.ai}
MAILCOW_SKIP_CLAMD=y
MAILCOW_SKIP_FTS=y
# host-side loopback ports for mailcow's own web stack (Traefik reaches
# nginx via the container network; pick any free loopback port):
#MAILCOW_HTTP_PORT=28080
#MAILCOW_HTTPS_PORT=28443
# ^ keep the demo lean; set n for production-grade antivirus/full-text search

# ── Traefik ──
TRAEFIK_ACME_EMAIL=admin@opensme.graphwiz.ai
# ACME directory. Default (unset) = LE STAGING — demo-safe, since the
# demo's .local/.test hosts can't get real certs. For production set:
# TRAEFIK_ACME_CA_SERVER=https://acme-v02.api.letsencrypt.org/directory
# Generate with: htpasswd -nb admin your-password
# (apr1 hash with SINGLE $ would be re-interpolated by compose as a var — keep $$ escaped)
TRAEFIK_USERS=admin:$$apr1$$CHANGEME

# ── Portal ──
# Empty = card hidden from portal landing page. Catalog functions only:
# identity/auth and Collabora (embedded editor) never get tiles.
MAIL_URL=
# Optional component cards (empty = hidden):
#   BPM_URL       https://bpm.<OPENSME_DOMAIN>       (camunda profile)
#   INVOICE_URL   https://invoice.<OPENSME_DOMAIN>   (invoice profile)
#   PAPERLESS_URL https://docs.<OPENSME_DOMAIN>      (paperless profile)
#   CHAT_URL      https://chat.<OPENSME_DOMAIN>      (synapse profile)
#   NOTES_URL     https://notes.<OPENSME_DOMAIN>     (notes service)

# ── Logging ──
LOG_LEVEL=info
LOG_PRETTY=true
TZ=Europe/Berlin

# ── Coexist Profile (existing Traefik) ──
# Set when using profiles/demo.coexist.yml to piggyback on a host Traefik.
EXISTING_NETWORK=traefik-web
EXISTING_TRAEFIK_HTTPS=websecure

# ── Feature Flags (set COMPOSE_FILE in env or cli) ──
COMPOSE_FILE=docker-compose.yml

# ── Optional Services (per-service DB passwords) ──
# Only needed if the corresponding service profile is enabled.
CASDOOR_DB_PASSWORD=CHANGEME_casdoor
CASDOOR_ADMIN_PASSWORD=CHANGEME_casdoor
# ^ Casdoor webadmin login (public auth UI) — rotated by init-env/demo; keep in sync with casdoor.yml
SYNAPSE_DB_PASSWORD=CHANGEME_synapse
# Zitadel-minted OIDC credentials (scripts/zitadel-client.sh --app synapse);
# a real (non-CHANGEME) client id is the opt-in switch for the OIDC block
SYNAPSE_OIDC_CLIENT_ID=
SYNAPSE_OIDC_CLIENT_SECRET=CHANGEME_synapse_oidc
PAPERLESS_DB_PASSWORD=CHANGEME_paperless
PAPERLESS_SECRET_KEY=CHANGEME_generate_64_chars
# Zitadel-minted OIDC credentials (scripts/zitadel-client.sh --app paperless);
# a real (non-CHANGEME) client id is the opt-in switch for the SSO block in
# services/paperless.yml (django-allauth generic OIDC, PKCE, auto-signup)
PAPERLESS_OIDC_CLIENT_ID=
PAPERLESS_OIDC_CLIENT_SECRET=CHANGEME_paperless_oidc
# Optional: IdP end-session URL for logout (default from the issuer discovery)
PAPERLESS_OIDC_LOGOUT_URL=
INVOICENINJA_DB_PASSWORD=CHANGEME_invoiceninja
INVOICENINJA_DB_ROOT_PASSWORD=CHANGEME_invoiceninja_root
# Zitadel OIDC SSO for Invoice Ninja v5 (services/invoice-ninja.yml). The
# callback is FIXED by the app: https://invoices.<OPENSME_DOMAIN>/auth/oidc.
# Register the client with: scripts/zitadel-client.sh --app invoiceninja
# (creates a client_secret_post app — Socialite authenticates in the body +
# PKCE). A bare name + verified-email user at the IdP maps onto the IN user
# with the SAME email (never auto-provisions).
INVOICENINJA_OIDC_ISSUER=https://auth.<ZITADEL_DOMAIN>
INVOICENINJA_OIDC_CLIENT_ID=CHANGEME_invoiceninja_oidc
INVOICENINJA_OIDC_CLIENT_SECRET=CHANGEME_invoiceninja_oidc
# Optional host HTTP-proxy for container->IdP egress (some hosts block
# container hairpin to the public IdP domain). Same pattern as the portal:
INVOICENINJA_HTTPS_PROXY=
INVOICENINJA_HTTP_PROXY=
INVOICENINJA_NO_PROXY=127.0.0.1,localhost,stalwart,redis,invoiceninja-db,*.opensme.local
NOTES_DB_PASSWORD=CHANGEME_notes
NOTES_DJANGO_SECRET_KEY=CHANGEME_notes_django
# Zitadel-minted OIDC credentials (scripts/zitadel-client.sh --app notes)
NOTES_OIDC_CLIENT_ID=
NOTES_OIDC_CLIENT_SECRET=CHANGEME_notes_oidc
NOTES_COLLABORATION_SECRET=CHANGEME_notes_collab

# ── Public Calendar (calrs + Radicale) ──
# Booking calendar edge-routed at CALENDAR_DOMAIN; its CalDAV store is
# internal-only on opensme-net. ADOPTED into the core stack (2026-11-07):
# the calendar + calendar-radicale services live in docker-compose.yml
# and are always included — no COMPOSE_FILE extension, no --profile.
CALENDAR_DOMAIN=calendar.opensme.graphwiz.ai
# Tile URL shown on the portal:
CALENDAR_URL=https://calendar.opensme.graphwiz.ai
CALRS_IMAGE_TAG=1.6.0
RADICALE_IMAGE_TAG=3.9.0.0
# Booking CalDAV login — seeded into Radicale's htpasswd by
# scripts/calendar-setup.sh. NEVER commit real values here:
RADICALE_USER=
RADICALE_PASSWORD=
# calrs bootstrap values for the operator (the FIRST registered user
# becomes admin). CALRS_VC_URL is the self-hosted video (LiveKit) origin
# used by the event-type form's "Use self-hosted video" helper: it fills
# the location field with `{VC}/room/{uid}`, and calrs substitutes {uid}
# with the booking's room-safe uid at booking time — every booking gets its
# OWN join URL (no copy-paste):
#   https://vc.example/room/{uid}  ->  https://vc.example/room/<uuid>
# CALRS_ADMIN_EMAIL/CALRS_ADMIN_PASSWORD also let the E2E suite
# (tests/05-e2e/stories.py Epic C6) cancel its own test events, keeping
# the demo calendar clean across runs.
CALRS_ADMIN_EMAIL=
CALRS_ADMIN_PASSWORD=
CALRS_VC_URL=https://vc.opensme.graphwiz.ai
# Optional SSO block — blank = local-auth only
CALRS_OIDC_ISSUER=
#
# Booking e-mail is NOT an env var: calrs holds its SMTP config in the
# `smtp_config` row of calrs.db (compose-internal Stalwart relay on this
# stack: host=stalwart, port=25, username='' — see docs/calendar.md).

# ── VC (LiveKit self-hosted video) ──
# SFU + minimal room UI, enabled with `--profile vc`. NO new docker
# networks: both services join opensme-net. Media rides a single muxed
# UDP port (VC_UDP_PORT) plus the ICE/TCP fallback (VC_TCP_PORT) —
# nothing else is published. The container cannot reach STUN servers
# (no runtime egress), so VC_PUBLIC_IP must be set to the host's
# public IPv4 and is advertised via NODE_IP instead.
VC_DOMAIN=vc.opensme.graphwiz.ai
# Portal tile URL:
VC_URL=https://vc.opensme.graphwiz.ai
VC_PUBLIC_IP=
VC_TCP_PORT=7881
VC_UDP_PORT=7882
LIVEKIT_IMAGE_TAG=v1.13.11
VC_ROOM_IMAGE_TAG=1.0.0
VC_TITLE="openSME Meet"
# Shared secret pair (SFU + token mint). Generate e.g.:
#   openssl rand -hex 24   (twice)
# NEVER commit real values here:
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
CALRS_OIDC_CLIENT_ID=
CALRS_OIDC_CLIENT_SECRET=

# ── Nosdesk ticketing (--profile ticketing) ──
NOSDESK_DB_PASSWORD=CHANGEME_nosdesk_db
# NOSDESK_IMAGE=nosdesk:1.0.12  # self-built (run `make nosdesk-image` first) —
#                               # the upstream ghcr.io/nosdesk/nosdesk release is
#                               # amd64-only, so ARM hosts must build from source.
# openssl rand -base64 32
NOSDESK_JWT_SECRET=CHANGEME_nosdesk_jwt
# openssl rand -hex 32
NOSDESK_MFA_KEK=CHANGEME_nosdesk_mfa
NOSDESK_OIDC_ISSUER=
NOSDESK_OIDC_CLIENT_ID=
NOSDESK_OIDC_CLIENT_SECRET=

# ── Operaton (BPMN workflow, --profile camunda) ──
# Operaton is the community-owned Apache 2.0 successor of Camunda 7 CE
# (same engine lineage, API/model/DB-schema compatible). The upstream
# image ships H2/MySQL/PostgreSQL JDBC drivers — no custom build needed.
# Override the image tag here (pinned to 2.1.5 by default).
# Service name and profile retain the "camunda" label for backward compat.
CAMUNDA_IMAGE=
CAMUNDA_DB_PASSWORD=CHANGEME_camunda
# Operaton host (defaults to bpm.<OPENSME_DOMAIN>); set to bpm.home.<domain>
# when using the coexist profile behind a fleet Traefik.
CAMUNDA_DOMAIN=

# ── Portal extras ──
# JSON array of {"level":"info|warn","text":"…"} banners shown on the portal
# Example: [{"level":"info","text":"Welcome to openSME"},{"level":"warn","text":"Maintenance window: Sun 02:00–04:00"}]
PORTAL_ANNOUNCEMENTS=
# HTTP CONNECT proxy for the portal's outbound feed fetches (HTTPS_PROXY inside
# the portal container). Only needed on egress-restricted hosts where container
# traffic cannot leave directly (e.g. OpenVZ without working MASQUERADE):
# point it at a local proxy reachable from the docker bridges, e.g.
# PORTAL_HTTPS_PROXY=http://<docker-gateway-ip>:8888 — empty = direct egress (default).
PORTAL_HTTPS_PROXY=
# News columns on the portal ("Aktuelles"), server-side RSS/Atom aggregation:
# JSON array of {"id","title","urls":[…]}. Empty = default columns:
#   startup (t3n, deutsche-startups), Markt (manager-magazin, handelsblatt),
#   Legal (LTO). Example: [{"id":"it","title":"IT","urls":["https://example.org/feed"]}]
PORTAL_FEEDS=
# BPM/Workflow (Operaton) — set to https://bpm.<OPENSME_DOMAIN> to show the
# Workflow card on the portal (requires --profile camunda)
BPM_URL=
# OpenAI-compatible chat endpoint, e.g. http://vllm:8000 (empty hides the AI card)
# With `--profile ai` set it to http://ai:8080 (built-in llama.cpp server)
AI_API_URL=
AI_MODEL=CHANGEME_model_name
AI_API_KEY=
# Intercom: hosts allowed as attachment sources (comma-separated,
# "host" or "host:port"; default cloud.<OPENSME_DOMAIN>) and a dev
# escape hatch to allow http:// attachment URLs (never set in prod)
INTERCOM_ATTACHMENT_HOSTS=
INTERCOM_ALLOW_HTTP=
# Team notes persistence: JSON file for the intercom store (picked-file
# uploads live in attachments/ next to it). Empty = compose default
# /data/intercom.json on the portal-data volume; survives restarts.
INTERCOM_DATA_PATH=
# FIFO cap for the intercom list (10..=500, default 50). Rotated-out
# picked-file uploads are garbage-collected; cloud links survive.
INTERCOM_MAX_MESSAGES=
# Polls (Umfragen): optional portal card + API. POLLS_ENABLED=1 turns the
# feature on. Attachments go to the cloud (OpenCloud) when CLOUD_WEBDAV_*
# are set — portal PUTs via WebDAV and creates a public read-only share
# link (OCS API); without them uploads fall back to the local
# attachments/ dir next to POLLS_DATA_PATH (rotated-out polls' local
# uploads are garbage-collected, cloud links survive). CLOUD_SHARE_URL
# overrides the OCS shares endpoint (default: derived from
# CLOUD_WEBDAV_URL host). One vote per signed-in member (OIDC session
# subject) is enforced SERVER-side; the API answers a boolean `voted`
# flag for the asking session and never exposes other members' subjects.
POLLS_ENABLED=
POLLS_DATA_PATH=
# OpenCloud WebDAV access (OPENCLOUD_ENABLE_BASIC_AUTH, CLOUD_WEBDAV_URL,
# CLOUD_WEBDAV_USER, CLOUD_WEBDAV_PASS, CLOUD_SHARE_URL) is documented and
# grouped in the "OpenCloud" section above — see "OpenCloud WebDAV Access".
# Comma-separated hosts the cloud-upload client must reach WITHOUT the
# egress proxy (docker-net service names, e.g. opensme-opencloud)
PORTAL_NO_PROXY=opencloud,minio,seaweedfs
# Portal cards for optional components (empty = card hidden)
TICKETING_URL=
CMS_URL=
SHOP_URL=
# Surveys (LimeSurvey CE) — https://surveys.${OPENSME_DOMAIN}
SURVEYS_URL=
# LimeSurvey tuning (upgrades: bump LIMESURVEY_TAG, data survives in
# limesurvey_db + limesurvey-uploads volume)
LIMESURVEY_TAG=6-apache
# public host for the survey tool (routed by traefik); the portal tile
# URL (SURVEYS_URL) is usually https://$SURVEYS_DOMAIN
SURVEYS_DOMAIN=surveys.${OPENSME_DOMAIN:-opensme.graphwiz.ai}
SURVEYS_DB_PASSWORD=
# Initial LimeSurvey admin (effective on FIRST start only)
SURVEYS_ADMIN_USER=admin
SURVEYS_ADMIN_PASSWORD=

# ── crap-cms website (--profile cms) ──
# upstream publishes :latest only; pin here once semver tags exist, e.g.
# CMS_IMAGE=ghcr.io/dkluhzeb/crap-cms:0.1.0
CMS_IMAGE=

# ── RaisFast store (--profile store) ──
# bootstrap admin password (otherwise printed once to logs on first boot)
STORE_ADMIN_PASSWORD=CHANGEME_store_admin
# build arch for the local image: x86_64 (amd64) or aarch64 (arm64)
STORE_ARCH=x86_64

# ── llama.cpp AI server (--profile ai) ──
# OpenAI-compatible inference at http://ai:8080 (point AI_API_URL there)
# build-numbered tag — llama.cpp publishes no semver docker tags
AI_IMAGE=
# HuggingFace model repo:quant, auto-downloaded to the ai-models volume on
# first boot (~1 GB for the default). Pick bigger models for more capability.
AI_HF_MODEL=
CRYPTPAD_ADMIN_EMAIL=admin@opensme.graphwiz.ai
CPAD_SESSION_SECRET=CHANGEME_cpad

# ── Monitoring (optional overlays) ──
# Include via COMPOSE_FILE=docker-compose.yml:monitoring/dev-agent.yml
# Images (replace with your registry/tag when ready):
#   Build locally with Nix: cd monitoring/nix && nix build .#dev-agent .#predictive-agent .#taskfleet
#   Then: docker load < result-dev-agent  (etc.)
#   Nix-built images use the *-nix tag (e.g., dev-agent:latest-nix)
DEV_AGENT_IMAGE=ghcr.io/tobias-weiss-ai-xr/dev-agent:latest
PREDICTIVE_AGENT_IMAGE=ghcr.io/tobias-weiss-ai-xr/predictive-agent:latest
TASKFLEET_IMAGE=ghcr.io/tobias-weiss-ai-xr/taskfleet:latest
# dev-maintenance-bot (Go, one-shot, runbook KB + consent-gated healing):
# DEV_MAINTENANCE_BOT_IMAGE=opensme-dev-maintenance-bot:latest   # local build via `make agent-build`
# DEV_AGENT_INTERVAL=60s          # reconcile interval
# DEV_AGENT_WATCH=opensme-compose   # comma-separated compose projects to watch
# DEV_AGENT_ALLOW_HEAL=false      # MUST stay false unless you accept real restarts
# DEV_AGENT_HOSTNAMES=            # extra hostnames the anonymizer scrubs (comma-separated)
# DEV_AGENT_HISTORY_MAX=100       # cap on persisted history+evidence entries
# DEV_AGENT_LLM_BACKEND=none      # none|ollama|saia|tud|openai — none = never dial out
# DEV_AGENT_LLM_URL=              # override backend URL
# DEV_AGENT_LLM_MODEL=            # override backend model
# DEV_AGENT_LLM_KEY=              # override backend API key (never logged)
# DEV_AGENT_LLM_MAX_REQUESTS=0    # max outbound LLM calls per run (0 = unlimited); agent pauses on exhaust
# DEV_MAINTENANCE_BOT_LLM_BACKEND=none  # bot-specific LLM opt-in (independent of DEV_AGENT_LLM_BACKEND)
# LLM backend (ollama | saia | tud | openai)
# For local Ollama, include monitoring/ollama.yml and keep OLLAMA_URL=http://ollama:11434
# For external LLM, set OLLAMA_URL to the endpoint and provide API keys as needed.
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen3-30b-a3b:latest
OLLAMA_TIMEOUT=180
# External LLM API keys (optional — only needed if LLM_BACKEND != ollama)
# DEV_AGENT_LLM_BACKEND=ollama
# PREDICTIVE_AGENT_LLM_BACKEND=ollama
# SAIA_API_URL=https://chat-ai.academiccloud.de/v1
# SAIA_API_KEY=
# TUD_API_URL=https://llm-service.ai.tu-darmstadt.de/v1
# TUD_API_KEY=
# OPENAI_API_URL=https://api.openai.com/v1
# OPENAI_API_KEY=
# Watch namespaces (comma-separated Docker compose project names)
# DEV_AGENT_WATCH_NAMESPACES=opensme,default
# PREDICTIVE_AGENT_WATCH_NAMESPACES=opensme,default
# Reconcile / analysis tuning
# DEV_AGENT_RECONCILE_INTERVAL=60
# PREDICTIVE_AGENT_RECONCILE_INTERVAL=60
# PREDICTION_ENABLED=true
# PREDICTION_RISK_THRESHOLD=0.5
# taskfleet
# TF_REPO_DIR=/path/to/your/repo
# TF_MAX_PARALLEL=2

# ── Image digest pinning ────────────────────────────────
# Pin stable images to a specific digest for reproducible deploys.
# Each <IMG>_IMAGE override in the compose files honours the digest form:
#   TRAEFIK_IMAGE_DIGEST=traefik:v3.3@sha256:<hex>
#   POSTGRES_IMAGE_DIGEST=postgres:17-alpine@sha256:<hex>
#   REDIS_IMAGE_DIGEST=redis:7-alpine@sha256:<hex>
#   MEMCACHED_IMAGE_DIGEST=memcached:1.6-alpine@sha256:<hex>
#   STALWART_IMAGE_DIGEST=stalwartlabs/stalwart:v0.15@sha256:<hex>
#   SOGO_IMAGE_DIGEST=salvoxia/sogo:latest@sha256:<hex>
# When set, keep the corresponding service's <IMG>_IMAGE pointing at the
# same tag@digest (asserted by tests/00-static/check_perf.py).

# ── Optional container image overrides ────────────
STALWART_IMAGE=stalwartlabs/stalwart:v0.15
COLLABORA_IMAGE=collabora/code:latest
PGBOUNCER_IMAGE=bitnamilegacy/pgbouncer:latest
TIKA_IMAGE=apache/tika:latest

# ── Blackbox monitoring blueprint (monitoring/blackbox/) ────────────────
# Probes every component through the public entry point with Prometheus +
# Blackbox exporter (see monitoring/blackbox/README.md). Targets resolve to
#   <sub>.<MONITOR_SUBDOMAIN_BASE><OPENSME_DOMAIN>  (per-service *_DOMAIN
# envs below override a single entry when set).
#   ""      → auth<domain>, webmail.<domain>, … (vanilla compose scheme)
#   "home." → auth.home.<domain>, … (live homelab scheme behind fleet Traefik)
MONITOR_SUBDOMAIN_BASE=
# Per-service overrides consumed by the blueprint (all optional):
#   PORTAL_DOMAIN, WEBMAIL_DOMAIN, AUTH_DOMAIN, CLOUD_DOMAIN, MAIL_DOMAIN,
#   NOTES_DOMAIN, CHAT_DOMAIN, MATRIX_DOMAIN, PAPERLESS_DOMAIN, BPM_DOMAIN,
#   SURVEYS_DOMAIN, COLLABORA_DOMAIN, INVOICES_DOMAIN, REGISTRY_DOMAIN,
#   OPENEDU_DOMAIN, NOSDESK_DOMAIN
