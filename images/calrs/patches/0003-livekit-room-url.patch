     use super::*;
 
+    // --- resolve_location (per-booking LiveKit room URL) ---
+
+    #[test]
+    fn resolve_location_substitutes_uid_into_room_url() {
+        let uid = "0f4f0bed-3f66-4a9c-8c1d-4ec8b2a9d031@calrs";
+        let out = resolve_location("https://vc.example/room/{uid}", uid);
+        // room name = uuid part only ('@' is not allowed in room names)
+        assert_eq!(out, "https://vc.example/room/0f4f0bed-3f66-4a9c-8c1d-4ec8b2a9d031");
+    }
+
+    #[test]
+    fn resolve_location_passthrough_without_template() {
+        assert_eq!(
+            resolve_location("https://vc.example/lobby", "whatever@calrs"),
+            "https://vc.example/lobby"
+        );
+    }
+
+    #[test]
+    fn resolve_location_no_suffix_uid() {
+        let out = resolve_location("https://vc.example/room/{uid}", "plain-room");
+        assert_eq!(out, "https://vc.example/room/plain-room");
