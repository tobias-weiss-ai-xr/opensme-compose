+/// Render a booking location value with per-booking substitutions.
+///
+/// `{uid}` is replaced with the booking's room-safe uid (the uuid part of
+/// `<uuid>@calrs`, without the `@calrs` suffix — room names must match
+/// `[A-Za-z0-9_-]`). This lets an event type use a templated self-hosted
+/// video (LiveKit) URL like `https://vc.example/room/{uid}` so every booking
+/// gets its OWN room link shown to the guest — no copying/pasting URLs.
+fn resolve_location<L: AsRef<str>>(loc: L, uid: &str) -> String {
+    let s = loc.as_ref();
+    if s.contains("{uid}") {
+        let room = uid.split('@').next().unwrap_or(uid);
+        s.replace("{uid}", room)
+    } else {
+        s.to_string()
+    }
+}
+
+/// Self-hosted video (LiveKit) base origin, from CALRS_VC_URL (fallback
+/// VC_URL). Used by the event-type form's "use self-hosted video" helper to
+/// fill a per-booking room template: `{base}/room/{uid}`.
+static VC_BASE: std::sync::OnceLock<Option<String>> = std::sync::OnceLock::new();
+fn vc_base_url() -> Option<String> {
+    VC_BASE
+        .get_or_init(|| {
+            std::env::var("CALRS_VC_URL")
+                .ok()
+                .or_else(|| std::env::var("VC_URL").ok())
+                .filter(|v| !v.trim().is_empty())
+                .map(|v| v.trim_end_matches('/').to_string())
+        })
+        .clone()
+}
