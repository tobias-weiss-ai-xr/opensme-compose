# Env — ignore all real env files; keep only the tracked templates
.env
.env.*
!.env.example
!.env.demo

# Digest-pinned image manifest (environment-specific, produced by --generate).
# Keep manifests/pinned-images.env.example tracked; never commit the real one.
manifests/pinned-images.env

# Runtime backup artifacts (scripts/backup.sh output).
# They carry a PostgreSQL dump, the Zitadel machine key and the OpenCloud
# config — never commit them.
backups/

# TLS certs
certs/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Rust
target/
portal/target/

# Docker
.docker/

# Nix build artifacts
result
result-*

# Logs
logs/
*.log
__pycache__/

# Next.js portal web app (portal/web)
node_modules/
portal/web/node_modules
portal/web/.next/
.eslintcache
# Zitadel masterkey + system API key (provisioned at deploy time)
idm/secrets/masterkey
idm/secrets/zitadel-system-key.pem
idm/secrets/zitadel-system-key.pub
# Zitadel healthcheck helper (static busybox binary, extracted at deploy time)
idm/zitadel/busybox

# mailcow runtime (secrets + rendered config — never commit)
mail/mailcow.conf
mail/mailcow-dockerized/data/
mail/mailcow-dockerized/helper-scripts/overwrite.conf
portal/web/tsconfig.tsbuildinfo
