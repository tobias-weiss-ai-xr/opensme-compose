# Env — ignore all real env files; keep only the tracked templates
.env
.env.*
!.env.example
!.env.demo

# Bootstrap checkpoint markers (scripts/bootstrap.sh --resume)
.bootstrap-state

# Digest-pinned image manifest (environment-specific, produced by --generate).
# Keep manifests/pinned-images.env.example tracked; never commit the real one.
manifests/pinned-images.env

# Runtime backup artifacts (scripts/backup.sh output).
# They carry a PostgreSQL dump, the Zitadel machine key and the OpenCloud
# config — never commit them.
backups/

# TLS certs — EXCEPT the deliberate lab fixture: traefik/dynamic.yml
# references traefik/certs/selfsigned.{crt,key} as the stable wildcard
# CA for the non-routable .local zone. If those two files are missing in
# a fresh checkout (e.g. because this rule swallowed them — the exact bug
# that killed CI from 0d6e9ef on: dynamic config pointing at a missing
# cert file kills Traefik's TLS handshake ENTIRELY), every TLS router
# dies. check_artifacts.py enforces that they stay tracked.
certs/
!traefik/certs/
!traefik/certs/selfsigned.crt
!traefik/certs/selfsigned.key

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Rust
target/
portal/target/

# Docker
.docker/

# Nix build artifacts
result
result-*

# Logs
logs/
*.log
__pycache__/

# Next.js portal web app (portal/web)
node_modules/
portal/web/node_modules
portal/web/.next/
.eslintcache
# Zitadel masterkey + system API key (provisioned at deploy time)
idm/secrets/masterkey
idm/secrets/zitadel-system-key.pem
idm/secrets/zitadel-system-key.pub
# Zitadel healthcheck helper (static busybox binary, extracted at deploy time)
idm/zitadel/busybox

# mailcow runtime (secrets + rendered config — never commit)
mail/mailcow.conf
mail/mailcow-dockerized/data/
mail/mailcow-dockerized/helper-scripts/overwrite.conf
portal/web/tsconfig.tsbuildinfo
tests/00-static/.internal-denylist.txt
