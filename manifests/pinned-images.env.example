# ── openSME — example digest-pinned image manifest ──────────────────
# Placeholder digests below — replace with real ones from:
#   scripts/pin-images.sh --generate        # writes manifests/pinned-images.env
#
# HOW TO USE
#   docker compose --env-file manifests/pinned-images.env up -d
#   # or export the vars instead of --env-file:
#   set -a; source manifests/pinned-images.env; set +a
#   # or bake it into your override stack (compose file order: last wins):
#   COMPOSE_FILE=docker-compose.yml:services/paperless.yml \
#     docker compose --env-file manifests/pinned-images.env --profile paperless up -d
#
# Each ACTIVE line pins one image to an immutable sha256 digest; it takes
# effect because the compose files already read ${VAR:-default} overrides.
# Commented lines are images WITHOUT an env-var override in the compose
# files yet — uncomment + wire a ${VAR} override in the compose file to
# activate the pin. Re-run --generate to refresh digests.

# ── Active overrides (compose files honour these env vars) ─────────
TRAEFIK_IMAGE=traefik@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
POSTGRES_IMAGE=postgres@sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
REDIS_IMAGE=redis@sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc

# ── No env override in the compose file yet — wire it to activate ──
# PAPERLESS_IMAGE=ghcr.io/paperless-ngx/paperless-ngx@sha256:dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd
# SYNAPSE_IMAGE=matrixdotorg/synapse@sha256:eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee
