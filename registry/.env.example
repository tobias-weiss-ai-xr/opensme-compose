# Registry pull-through configuration.
# Copy to .env next to registry-compose.yml (never commit the token) and set
# a read-scoped PAT. The ghcr packages under tobias-weiss-ai-xr/openedusuite/*
# are currently PRIVATE, so anonymous pull-through fails until either the
# packages are made public or this token is provided.

# GitHub read-scoped token (classic PAT with at least `read:packages`).
# Runs the registry's pull-through proxy to ghcr.io on the mirror's behalf.
REGISTRY_PROXY_PASSWORD=ghp_your_read_scoped_token_here
